#!/bin/bash
# Wrapper to run validate_meets.py with the correct Python environment.
# Mirrors check_parser: the script needs the scraper venv (pyyaml) and must run
# from the scraper directory so `meets_config` is importable.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_PYTHON="$SCRIPT_DIR/.venv/bin/python"

if [ ! -f "$VENV_PYTHON" ]; then
    echo "Error: Virtual environment not found at $VENV_PYTHON" >&2
    exit 1
fi

cd "$SCRIPT_DIR"
exec "$VENV_PYTHON" "$SCRIPT_DIR/validate_meets.py" "$@"
